  "main": "lib/index.js",
  "license": "MIT",
  "author": "reisen0327-sudo",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "education",
    "teaching",
    "tutor",
    "agent-preset"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reisen0327-sudo/dsh-teacher-mode.git"
  },
  "homepage": "https://github.com/reisen0327-sudo/dsh-teacher-mode#readme",
  "bugs": {
    "url": "https://github.com/reisen0327-sudo/dsh-teacher-mode/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
